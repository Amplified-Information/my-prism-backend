{
  "name": "web",
  "type": "commonjs",
  "version": "0.1.0",
  "description": "This is the Prism web app",
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:dev": "vite build --mode development",
    "dev": "vite",
    "local": "vite --port ${PORT:-8081}",
    "gen": "rm -rf gen && mkdir -p gen && ./node_modules/.bin/protoc -I=../clob/proto --ts_out=gen ../clob/proto/*.proto || npm run gen.submodule",
    "gen.submodule": "echo \"\n----\ngenerating protobufs for submodule...\" && echo \"\n\t--> Ensure the repo '../prism' exists in parallel to this repo and you have pulled the latest protobufs\n\" && rm -rf gen && mkdir -p gen && ./node_modules/.bin/protoc -I=../prism/clob/proto --ts_out=gen ../prism/clob/proto/*.proto && echo \"protobuf interfaces for submodule generated ✅.\"",
    "gen.old": "rm -rf gen && mkdir -p gen && ./node_modules/.bin/protoc -I=../api/proto -I=../clob/proto --ts_out=gen ../api/proto/*.proto ../clob/proto/*.proto",
    "lint": "eslint .",
    "test": "vitest run"
  },
